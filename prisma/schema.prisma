datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id                       String   @id @default(cuid())
  phoneNumber              String   @unique
  telegramUserId           BigInt   @unique
  telegramAccessHash       String
  telegramSessionEncrypted String   @db.Text
  telegramSessionIv        String   // IV for AES-256-GCM
  telegramSessionAuthTag   String   // Auth tag for AES-256-GCM
  storageChannelId         BigInt?
  storageChannelAccessHash String?
  displayName              String?
  username                 String?
  profilePhotoUrl          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  sessions Session[]
  files    File[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model File {
  id                String   @id @default(cuid())
  userId            String
  telegramMessageId Int
  fileName          String
  fileSize          BigInt
  mimeType          String
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("files")
}

model UploadJob {
  id             String   @id @default(cuid())
  userId         String
  fileName       String
  fileSize       BigInt
  tempFilePath   String
  mimeType       String   @default("application/octet-stream")
  status         String   // "queued", "processing", "completed", "failed", "cancelled"
  progress       Float    @default(0)
  uploadedBytes  BigInt   @default(0)
  errorMessage   String?  @db.Text
  retries        Int      @default(0)
  maxRetries     Int      @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("upload_jobs")
}
